# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Founder alert. The lead is still saved when these are empty.
RESEND_API_KEY=""
RESEND_FROM="Vamos Properties <leads@example.com>"
LEAD_NOTIFY_EMAIL="patrick@example.com,jaime@example.com"

# Admin sign-in. The session secret must be at least 32 characters.
# The bootstrap account is created once, the first time someone signs in, if the User table is empty.
ADMIN_SESSION_SECRET=""
ADMIN_BOOTSTRAP_EMAIL="patrick@example.com"
ADMIN_BOOTSTRAP_NAME="Patrick"
ADMIN_BOOTSTRAP_PASSWORD=""
