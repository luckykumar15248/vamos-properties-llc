# Copy this file to `.env` and fill in the real values.
# Never commit `.env`. Never print DATABASE_URL.

# ── PostgreSQL (Vercel Postgres / local) ──────────────────────────────────────
# Format:
#   postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
#
# On Vercel, paste the pooled connection string into DATABASE_URL.
# Prisma adds connection_limit=1 when it is missing so each serverless
# isolate uses one client connection against the pooler.
#
# Apply schema:
#   npx prisma db push

DATABASE_URL="postgresql://user:password@localhost:5432/vamos?schema=public"

# Founder alert. The lead is still saved when these are empty.
RESEND_API_KEY=""
RESEND_FROM="Vamos Properties <leads@example.com>"
LEAD_NOTIFY_EMAIL="patrick@example.com,jaime@example.com"

# Admin sign-in. The session secret must be at least 32 characters.
# The bootstrap account is created once, the first time someone signs in, if the User table is empty.
ADMIN_SESSION_SECRET=""
ADMIN_BOOTSTRAP_EMAIL="patrick@example.com"
ADMIN_BOOTSTRAP_NAME="Patrick"
ADMIN_BOOTSTRAP_PASSWORD=""

# Media library. Leave these empty until the S3 bucket is ready.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_S3_PUBLIC_BASE_URL=""
