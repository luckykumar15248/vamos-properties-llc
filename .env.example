# Copy this file to `.env` and fill in the real values.
# Never commit `.env`. Never print DATABASE_URL.

# ── MySQL on AWS EC2 ──────────────────────────────────────────────────────────
# Format:
#   mysql://USER:PASSWORD@EC2_HOST:3306/DB_NAME
#
# Query params Prisma understands (we also add the pool defaults in code if
# they are missing):
#   connection_limit=1   one connection per Vercel serverless instance
#   pool_timeout=10      seconds to wait for a free connection
#   connect_timeout=10   seconds to establish TCP + handshake
#   sslaccept=strict     verify the server certificate (use this in production
#                        once MySQL has a real cert)
#   sslaccept=accept_invalid_certs
#                        encrypt traffic but skip hostname/CA checks (self-signed)
#
# Example (self-signed cert on EC2):
#   DATABASE_URL="mysql://app:secret@ec2-xx.compute.amazonaws.com:3306/vamos?sslaccept=accept_invalid_certs"
#
# Vercel: set DATABASE_URL and MYSQL_SSL_MODE on the project. Do not put the
# password in the repo. Rotate the MySQL user if a URL ever leaked.
#
# Apply schema to a fresh MySQL database:
#   npx prisma db push          first bring-up
#   npx prisma migrate deploy   once migration files are in prisma/migrations

DATABASE_URL="mysql://user:password@your-ec2-host:3306/vamos"

# required = TLS with accept_invalid_certs (typical self-signed EC2)
# strict   = TLS and verify the certificate
# off      = no extra sslaccept (local MySQL without TLS)
MYSQL_SSL_MODE="required"

# Founder alert. The lead is still saved when these are empty.
RESEND_API_KEY=""
RESEND_FROM="Vamos Properties <leads@example.com>"
LEAD_NOTIFY_EMAIL="patrick@example.com,jaime@example.com"

# Admin sign-in. The session secret must be at least 32 characters.
# The bootstrap account is created once, the first time someone signs in, if the User table is empty.
ADMIN_SESSION_SECRET=""
ADMIN_BOOTSTRAP_EMAIL="patrick@example.com"
ADMIN_BOOTSTRAP_NAME="Patrick"
ADMIN_BOOTSTRAP_PASSWORD=""

# Media library. Leave these empty until the S3 bucket is ready.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_S3_PUBLIC_BASE_URL=""
