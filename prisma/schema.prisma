// Prisma 5 schema for MySQL on AWS EC2.
// Vercel serverless talks to this database through DATABASE_URL.
// Apply: npx prisma migrate deploy   or   npx prisma db push
// Generate client: npx prisma generate  (also runs on npm postinstall)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int          @id @default(autoincrement())
  email         String       @unique @db.VarChar(191)
  name          String       @db.VarChar(191)
  role          String       @default("owner") @db.VarChar(32)
  passwordHash  String       @db.VarChar(255)
  assignedLeads Lead[]
  events        LeadEvent[]
  mediaAssets   MediaAsset[]
  posts         Post[]
  comments      Comment[]
  createdAt     DateTime     @default(now())
}

model Lead {
  id              Int         @id @default(autoincrement())
  address         String      @db.VarChar(255)
  unit            String?     @db.VarChar(64)
  city            String?     @db.VarChar(128)
  name            String      @db.VarChar(191)
  phone           String      @db.VarChar(32)
  email           String?     @db.VarChar(191)
  message         String?     @db.Text
  situation       String      @db.VarChar(64)
  trusteeSaleDate String?     @db.VarChar(32)
  preferredPath   String      @db.VarChar(32)
  language        String      @db.VarChar(8)
  status          String      @default("new") @db.VarChar(32)
  lostReason      String?     @db.VarChar(64)
  sourcePath      String      @db.VarChar(255)
  utmSource       String?     @db.VarChar(128)
  utmMedium       String?     @db.VarChar(128)
  utmCampaign     String?     @db.VarChar(128)
  assignedToId    Int?
  assignedTo      User?       @relation(fields: [assignedToId], references: [id])
  consents        Consent[]
  events          LeadEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([trusteeSaleDate])
  @@index([assignedToId])
}

model Consent {
  id          Int      @id @default(autoincrement())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      Int
  channel     String   @db.VarChar(16)
  textVersion String   @db.Text
  pageUrl     String   @db.Text
  ipHash      String   @db.VarChar(128)
  grantedAt   DateTime @default(now())

  @@index([leadId])
}

model LeadEvent {
  id         Int      @id @default(autoincrement())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     Int
  author     String   @default("system") @db.VarChar(64)
  authorId   Int?
  authorUser User?    @relation(fields: [authorId], references: [id])
  type       String   @db.VarChar(32)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([authorId])
}

model Listing {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(191)
  slug            String         @unique @db.VarChar(191)
  address         String         @db.VarChar(255)
  city            String?        @db.VarChar(128)
  beds            Int?
  baths           String?        @db.VarChar(16)
  sqft            Int?
  propertyType    String?        @db.VarChar(64)
  price           String?        @db.VarChar(64)
  listPrice       Int?
  previousPrice   Int?
  priceChangedAt  DateTime?
  monthlyPayment  Int?
  terms           String?        @db.Text
  status          String         @default("draft") @db.VarChar(32)
  featured        Boolean        @default(false)
  summary         String?        @db.Text
  description     String?        @db.LongText
  features        String?        @db.Text
  neighborhood    String?        @db.Text
  schools         String?        @db.Text
  yearBuilt       Int?
  metaTitle       String?        @db.VarChar(191)
  metaDescription String?        @db.VarChar(300)
  keywords        String?        @db.Text
  localTags       String?        @db.Text
  photos          String?        @db.Text
  publishedAt     DateTime?
  prices          ListingPrice[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([city])
  @@index([listPrice])
  @@index([featured])
}

model ListingPrice {
  id             Int      @id @default(autoincrement())
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId      Int
  amount         Int
  previousAmount Int?
  recordedAt     DateTime @default(now())

  @@index([listingId])
}

model MediaAsset {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(191)
  url         String   @db.Text
  fileName    String   @db.VarChar(255)
  contentType String   @db.VarChar(128)
  kind        String   @db.VarChar(32)
  sizeBytes   Int
  folder      String?  @db.VarChar(128)
  alt         String?  @db.VarChar(191)
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([kind])
  @@index([folder])
  @@index([createdAt])
  @@index([createdById])
}

model Post {
  id               Int            @id @default(autoincrement())
  slug             String         @unique @db.VarChar(191)
  title            String         @db.VarChar(191)
  excerpt          String?        @db.Text
  body             String         @db.LongText
  status           String         @default("draft") @db.VarChar(32)
  featuredImageUrl String?        @db.Text
  featuredImageAlt String?        @db.VarChar(191)
  metaTitle        String?        @db.VarChar(191)
  metaDescription  String?        @db.VarChar(300)
  canonicalUrl     String?        @db.Text
  ogImageUrl       String?        @db.Text
  publishedAt      DateTime?
  author           User?          @relation(fields: [authorId], references: [id])
  authorId         Int?
  categories       PostCategory[]
  tags             PostTag[]
  comments         Comment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model Category {
  id          Int            @id @default(autoincrement())
  slug        String         @unique @db.VarChar(191)
  name        String         @db.VarChar(191)
  description String?        @db.Text
  parent      Category?      @relation("CategoryParent", fields: [parentId], references: [id])
  parentId    Int?
  children    Category[]     @relation("CategoryParent")
  posts       PostCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId])
}

model Tag {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(191)
  name      String    @db.VarChar(191)
  posts     PostTag[]
  createdAt DateTime  @default(now())
}

model PostCategory {
  id         Int      @id @default(autoincrement())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model PostTag {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Comment {
  id          Int       @id @default(autoincrement())
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  parent      Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    Int?
  replies     Comment[] @relation("CommentThread")
  author      User?     @relation(fields: [authorId], references: [id])
  authorId    Int?
  authorName  String    @db.VarChar(191)
  authorEmail String?   @db.VarChar(191)
  body        String    @db.Text
  status      String    @default("pending") @db.VarChar(32)
  isStaff     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([status])
  @@index([authorId])
}
