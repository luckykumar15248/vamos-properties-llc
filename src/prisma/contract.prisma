// use prisma-8

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  name          String
  role          String      @default("owner")
  passwordHash  String
  assignedLeads Lead[]
  events        LeadEvent[]
  mediaAssets   MediaAsset[]
  posts         Post[]
  comments      Comment[]
  createdAt     TimestamptzString @default(now())
}

model Lead {
  id              Int         @id @default(autoincrement())
  address         String
  unit            String?
  city            String?
  name            String
  phone           String
  email           String?
  message         String?
  situation       String
  trusteeSaleDate String?
  preferredPath   String
  language        String
  status          String      @default("new")
  lostReason      String?
  sourcePath      String
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  assignedToId    Int?
  assignedTo      User?       @relation(fields: [assignedToId], references: [id])
  consents        Consent[]
  events          LeadEvent[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([trusteeSaleDate])
  @@index([assignedToId])
}

model Consent {
  id          Int               @id @default(autoincrement())
  lead        Lead              @relation(fields: [leadId], references: [id])
  leadId      Int
  channel     String
  textVersion String
  pageUrl     String
  ipHash      String
  grantedAt   TimestamptzString @default(now())

  @@index([leadId])
}

model LeadEvent {
  id         Int               @id @default(autoincrement())
  lead       Lead              @relation(fields: [leadId], references: [id])
  leadId     Int
  author     String            @default("system")
  authorId   Int?
  authorUser User?             @relation(fields: [authorId], references: [id])
  type       String
  body       String
  createdAt  TimestamptzString @default(now())

  @@index([leadId])
  @@index([authorId])
}

model Listing {
  id              Int               @id @default(autoincrement())
  title           String
  slug            String            @unique
  address         String
  city            String?
  beds            Int?
  baths           String?
  sqft            Int?
  propertyType    String?
  price           String?
  listPrice       Int?
  previousPrice   Int?
  priceChangedAt  TimestamptzString?
  monthlyPayment  Int?
  terms           String?
  status          String            @default("draft")
  featured        Boolean           @default(false)
  summary         String?
  description     String?
  features        String?
  neighborhood    String?
  schools         String?
  yearBuilt       Int?
  metaTitle       String?
  metaDescription String?
  keywords        String?
  localTags       String?
  photos          String?
  publishedAt     TimestamptzString?
  prices          ListingPrice[]
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([status])
  @@index([city])
  @@index([listPrice])
  @@index([featured])
}

model ListingPrice {
  id             Int               @id @default(autoincrement())
  listing        Listing           @relation(fields: [listingId], references: [id])
  listingId      Int
  amount         Int
  previousAmount Int?
  recordedAt     TimestamptzString @default(now())

  @@index([listingId])
}

model MediaAsset {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  url         String
  fileName    String
  contentType String
  kind        String
  sizeBytes   Int
  folder      String?
  alt         String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   TimestamptzString @default(now())

  @@index([kind])
  @@index([folder])
  @@index([createdAt])
  @@index([createdById])
}

model Post {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  title            String
  excerpt          String?
  body             String
  status           String            @default("draft")
  featuredImageUrl String?
  featuredImageAlt String?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogImageUrl       String?
  publishedAt      TimestamptzString?
  author           User?             @relation(fields: [authorId], references: [id])
  authorId         Int?
  categories       PostCategory[]
  tags             PostTag[]
  comments         Comment[]
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model Category {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  name        String
  description String?
  parent      Category?         @relation("CategoryParent", fields: [parentId], references: [id])
  parentId    Int?
  children    Category[]        @relation("CategoryParent")
  posts       PostCategory[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([parentId])
}

model Tag {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  name      String
  posts     PostTag[]
  createdAt TimestamptzString @default(now())
}

model PostCategory {
  id         Int      @id @default(autoincrement())
  post       Post     @relation(fields: [postId], references: [id])
  postId     Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model PostTag {
  id     Int  @id @default(autoincrement())
  post   Post @relation(fields: [postId], references: [id])
  postId Int
  tag    Tag  @relation(fields: [tagId], references: [id])
  tagId  Int

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Comment {
  id          Int               @id @default(autoincrement())
  post        Post              @relation(fields: [postId], references: [id])
  postId      Int
  parent      Comment?          @relation("CommentThread", fields: [parentId], references: [id])
  parentId    Int?
  replies     Comment[]         @relation("CommentThread")
  author      User?             @relation(fields: [authorId], references: [id])
  authorId    Int?
  authorName  String
  authorEmail String?
  body        String
  status      String            @default("pending")
  isStaff     Boolean           @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([postId])
  @@index([parentId])
  @@index([status])
  @@index([authorId])
}
